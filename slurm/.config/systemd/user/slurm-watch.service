[Unit]
Description=Desktop notifications when SLURM jobs on the ICER cluster start and finish

[Service]
# slurm-on-finish and icer-fetch-plots live in ~/.local/bin.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/slurm-watch hpcc-dev
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
