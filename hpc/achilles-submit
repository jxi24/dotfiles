#!/bin/bash
# Submit an Achilles run on the ICER cluster as a SLURM job array, plus an
# optional analysis job that starts when every event job has succeeded.
# Run it from inside an Achilles worktree that has been built.
#
#   achilles-submit [options] <run card>
#     -n N        number of array tasks (default 10); NEvents is split across them
#     -a CMD      analysis command, run in the run directory after all tasks succeed.
#                 $EVENT_FILES lists the event files; write plots to plots/.
#     -A ACCOUNT  SLURM account. Without it you are asked when you have several.
#     -p PART     partition (default: let SLURM choose)
#     -t TIME     time limit per task (default 04:00:00)
#     -m MEM      memory per task (default 4G)
#     -s SEED     base seed; task i uses SEED + i (default 1000)
#     -d JOB      start only after job JOB succeeds, e.g. the id achilles-build printed
#     -I          integrate in every task instead of once up front
#     -P PROJECT  the GTD project the run is noted under (default Achilles)
#
# Each run gets $SCRATCH/achilles/<date>-<card>/. A first job integrates once
# in integrate/; then each array task copies that cache into its own task-NNN/
# directory, so tasks skip the integration but never share a cache (issue
# #189). Uncommitted changes in the worktree are saved as changes.patch.
# Scratch is purged after a while: plots are what you keep. The laptop's
# slurm-watch copies plots/ home when the analysis job finishes.

set -euo pipefail

tasks=10 analysis="" account="" partition="" time=04:00:00 mem=4G seed=1000 after="" integrate=true project=Achilles
while getopts "n:a:A:p:t:m:s:d:IP:h" opt; do
    case $opt in
    n) tasks=$OPTARG ;;
    a) analysis=$OPTARG ;;
    A) account=$OPTARG ;;
    p) partition=$OPTARG ;;
    t) time=$OPTARG ;;
    m) mem=$OPTARG ;;
    s) seed=$OPTARG ;;
    d) after=$OPTARG ;;
    I) integrate=false ;;
    P) project=$OPTARG ;;
    *) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
    esac
done
shift $((OPTIND - 1))
card=${1:?usage: achilles-submit [options] <run card>   (-h for help)}
[[ -f $card ]] || { echo "No run card at $card"; exit 1; }
card=$(realpath "$card")

worktree=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "Run this inside an Achilles worktree."; exit 1; }
binary=$worktree/build/bin/achilles
[[ -x $binary || -n $after ]] || { echo "No build at $binary. Run achilles-build first."; exit 1; }
[[ -n ${SCRATCH:-} ]] || { echo "\$SCRATCH isn't set."; exit 1; }

# Account: use -A, the only one you have, or ask.
[[ -n $account ]] || account=$(~/.dotfiles/hpc/pick-account)

run_id=$(date +%Y%m%d-%H%M%S)-$(basename "$card" .yml)
run=$SCRATCH/achilles/$run_id
mkdir -p "$run/logs" "$run/plots"
cp "$card" "$run/run.yml"

# Provenance: what code produced these events.
{
    echo "card:     $card"
    echo "worktree: $worktree"
    echo "commit:   $(git -C "$worktree" rev-parse HEAD)"
    git -C "$worktree" diff --quiet HEAD || echo "changes:  uncommitted changes, saved in changes.patch"
    if [[ -n $after ]]; then
        echo "binary:   $binary (built by job $after)"
    else
        echo "binary:   $binary (built $(date -r "$binary" '+%F %T'))"
    fi
    echo "tasks:    $tasks, base seed $seed, account ${account:-default}"
    echo "analysis: ${analysis:-none}"
    echo "project:  $project"
} >"$run/provenance.txt"
git -C "$worktree" diff --quiet HEAD || git -C "$worktree" diff HEAD >"$run/changes.patch"

# One run card per task: its share of NEvents and its own seed. The seed lives
# in the Options file the card includes, so each task gets a local copy of it.
ACHILLES_PATH=$worktree python3 - "$card" "$run" "$tasks" "$seed" <<'EOF'
import os, re, sys
card, run, tasks, seed = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
text = open(card).read()
m = re.search(r'^(\s*)NEvents:\s*(\d+)', text, re.M)
if not m:
    sys.exit("The run card has no NEvents.")
per_task = -(-int(m.group(2)) // tasks)

def set_seed(options, value):
    if re.search(r'^\s*Seed:', options, re.M):
        return re.sub(r'^(\s*Seed:\s*)\S+', lambda s: s.group(1) + str(value), options, count=1, flags=re.M)
    return "Initialize:\n  Seed: %d\n" % value + options if not re.search(r'^Initialize:', options, re.M) \
        else re.sub(r'^Initialize:\n', 'Initialize:\n  Seed: %d\n' % value, options, count=1, flags=re.M)

inc = re.search(r'^Options:[ \t]*!include[ \t]+"?([^"\n]+?)"?[ \t]*$', text, re.M)
if inc:
    path = inc.group(1)
    for d in [os.path.dirname(card), os.environ["ACHILLES_PATH"]]:
        if os.path.exists(os.path.join(d, path)):
            options = open(os.path.join(d, path)).read()
            break
    else:
        sys.exit("Can't find the Options file " + path)

for i in range(1, tasks + 1):
    task = os.path.join(run, "task-%03d" % i)
    os.makedirs(task)
    t = re.sub(r'^(\s*NEvents:\s*)\d+', lambda s: s.group(1) + str(per_task), text, count=1, flags=re.M)
    if inc:
        open(os.path.join(task, "options.yml"), "w").write(set_seed(options, seed + i))
        # Matched again on t: its NEvents edit may have shifted inc's offsets.
        t = re.sub(r'^Options:[ \t]*!include[ \t]+.*$', 'Options: !include "options.yml"', t, count=1, flags=re.M)
    elif re.search(r'^Options:', t, re.M):
        t = set_seed(t, seed + i)  # inline Options block
    else:
        t += "\nOptions:\n  Initialize:\n    Seed: %d\n" % (seed + i)
    open(os.path.join(task, "run.yml"), "w").write(t)

# The integration job: the first task's card with a single event.
os.makedirs(os.path.join(run, "integrate"))
for name in os.listdir(os.path.join(run, "task-001")):
    t = open(os.path.join(run, "task-001", name)).read()
    if name == "run.yml":
        t = re.sub(r'^(\s*NEvents:\s*)\d+', lambda s: s.group(1) + "1", t, count=1, flags=re.M)
    open(os.path.join(run, "integrate", name), "w").write(t)
print("%d tasks of %d events each" % (tasks, per_task))
EOF

# --kill-on-invalid-dep: when a job this depends on fails, SLURM cancels this
# one instead of leaving it pending forever.
common=(--parsable --time="$time" --mem="$mem" --cpus-per-task=1 --kill-on-invalid-dep=yes)
# The laptop's slurm-watch notes the run's last job under its project (in the
# Work vault); the helper jobs before it say log=no.
helper=(--comment="project=$project;log=no")
[[ -n $account ]] && common+=(--account="$account")
[[ -n $partition ]] && common+=(--partition="$partition")

dep=()
[[ -n $after ]] && dep=(--dependency="afterok:$after")

if $integrate; then
    integ=$(sbatch "${common[@]}" "${helper[@]}" "${dep[@]}" --job-name="int-$run_id" \
        --output="$run/logs/integrate.out" <<EOF
#!/bin/bash -l
source ~/.dotfiles/hpc/achilles-env.sh
cd "$run/integrate"
export ACHILLES_PATH="$worktree"
"$binary" -b run.yml
[[ -n "$after" ]] && echo "built:    \$(date -r "$binary" '+%F %T')" >> ../provenance.txt
if [[ -z \$(ls -A .achilles 2>/dev/null) ]]; then
    echo "The integration wrote no cache; see achilles.log"
    exit 1
fi
EOF
)
    echo "Integration: job $integ"
    dep=(--dependency="afterok:$integ")
fi

events=$(sbatch "${common[@]}" "${helper[@]}" "${dep[@]}" --job-name="ach-$run_id" --array="1-$tasks" \
    --output="$run/logs/task-%a.out" <<EOF
#!/bin/bash -l
source ~/.dotfiles/hpc/achilles-env.sh
cd "$run/task-\$(printf %03d \$SLURM_ARRAY_TASK_ID)"
export ACHILLES_PATH="$worktree"
# Start from the shared integration, in a copy of its own (issue #189).
[[ -d ../integrate/.achilles ]] && cp -r ../integrate/.achilles .
"$binary" -b run.yml
# Achilles exits 0 even when the run fails, so check that it wrote events.
status=\$?
if grep -q "Concluded - Failed" achilles.log 2>/dev/null || ! ls *.hepmc* >/dev/null 2>&1; then
    echo "Achilles wrote no events; see achilles.log"
    exit 1
fi
exit \$status
EOF
)
echo "Events:   job $events ($tasks tasks) -> $run"

if [[ -n $analysis ]]; then
    ana=$(sbatch "${common[@]}" --comment="project=$project" --job-name="ana-$run_id" --dependency="afterok:$events" \
        --output="$run/logs/analysis.out" <<EOF
#!/bin/bash -l
source ~/.dotfiles/hpc/achilles-env.sh
cd "$run"
export RUN_DIR="$run" ACHILLES_PATH="$worktree"
export EVENT_FILES="\$(ls -d task-*/* | grep -E '\.(hepmc|hepmc3)(\.gz)?$' | tr '\n' ' ')"
$analysis
EOF
)
    echo "Analysis: job $ana, after every event task succeeds; plots -> $run/plots"
else
    # No analysis: a one-second job marks the end of the run, so it's still
    # noted (and notified) once every task has succeeded.
    sbatch --parsable --time=00:01:00 --mem=100M --cpus-per-task=1 --kill-on-invalid-dep=yes \
        ${account:+--account="$account"} ${partition:+--partition="$partition"} --comment="project=$project" \
        --job-name="end-$run_id" --dependency="afterok:$events" --output=/dev/null >/dev/null <<EOF
#!/bin/bash
true
EOF
fi

# Start the laptop's job watcher, if the icer connection is up.
~/.dotfiles/hpc/slurm-wake
