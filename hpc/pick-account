#!/bin/bash
# Print the SLURM account to use: the only one you have, or ask when you have
# several. Prints nothing (SLURM's default) if none are found.
mapfile -t accounts < <(sacctmgr -nP show assoc user="$USER" format=account | sort -u | grep .)
if ((${#accounts[@]} == 1)); then
    echo "${accounts[0]}"
elif ((${#accounts[@]} > 1)); then
    PS3="Which SLURM account? " 
    select account in "${accounts[@]}"; do [[ -n $account ]] && break; done </dev/tty >/dev/tty 2>&1
    echo "$account"
fi
